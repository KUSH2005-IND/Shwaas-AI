FROM node:24.22.1-slim AS ui
WORKDIR /build
COPY clinical/package*.json ./
RUN npm ci
COPY clinical/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY requirements-clinical.txt ./
RUN pip install --no-cache-dir -r requirements-clinical.txt
COPY server/ server/
COPY --from=ui /build/dist clinical/dist/
RUN mkdir -p data && useradd --create-home --uid 10001 clinical && chown -R clinical:clinical /app
USER clinical
EXPOSE 8060
CMD ["python", "-m", "uvicorn", "server.clinical:app", "--host", "0.0.0.0", "--port", "8060"]
